# Backend (server-side only — never expose to the browser)
VISECA_BASE_URL=https://saw26api.ashyground-364e1d07.switzerlandnorth.azurecontainerapps.io
VISECA_API_KEY=
ONEGUARD_DATABASE_URL=                # unset = sqlite:///./oneguard.sqlite; Supabase session pooler: postgresql+psycopg://...:5432/postgres
ONEGUARD_ENV=dev                      # prod refuses make reset-db
ONEGUARD_STUBS=                       # unset = real where present | all | none | build_facts,decide,...
ONEGUARD_SOFT_SIGNALS=keywords        # off | keywords | laya
ONEGUARD_LLM_PROVIDER=openai          # openai | anthropic | null
OPENAI_API_KEY=
ANTHROPIC_API_KEY=                    # alternative provider
ONEGUARD_ENGINE_BUDGET_MS=2000

# Frontend (see frontend/.env.example)
